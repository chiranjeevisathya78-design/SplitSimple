# ============================================
# SplitSimple — Environment Variables Template
# ============================================
# Copy this to .env.production and fill values
# NEVER commit the actual .env file to git!

# MongoDB Atlas connection string (get from cloud.mongodb.com)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/splitsimple?retryWrites=true&w=majority

# JWT Secret — use a long random string (min 32 chars)
JWT_SECRET=replace_with_a_very_long_random_secret_key_min_32_chars

# App Environment
NODE_ENV=production

# Port — Railway sets this automatically, don't override
# PORT=5000
